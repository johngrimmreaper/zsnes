#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

# Match upstream's architecture-specific position-independence policy.
# x86 uses absolute addressing and links non-PIE; arm64 and riscv64 require
# position-independent code and retain Debian's PIE hardening.
ifneq (,$(filter amd64 i386,$(DEB_HOST_ARCH)))
export DEB_BUILD_MAINT_OPTIONS = hardening=+all,-pie
else
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
endif

export CFLAGS := $(shell dpkg-buildflags --get CFLAGS)
export LDFLAGS := $(shell dpkg-buildflags --get LDFLAGS)

SUPPORTED_ARCHES := amd64 i386 arm64 riscv64

ifeq ($(DEB_HOST_ARCH),amd64)
UPSTREAM_BITS := 64
UPSTREAM_CPU := x86
else ifeq ($(DEB_HOST_ARCH),i386)
UPSTREAM_BITS := 32
UPSTREAM_CPU := x86
else ifeq ($(DEB_HOST_ARCH),arm64)
UPSTREAM_BITS := 64
UPSTREAM_CPU := arm64
else ifeq ($(DEB_HOST_ARCH),riscv64)
UPSTREAM_BITS := 64
UPSTREAM_CPU := riscv64
endif

%:
	dh $@

override_dh_auto_configure:
	@case " $(SUPPORTED_ARCHES) " in \
		*" $(DEB_HOST_ARCH) "*) ;; \
		*) \
			echo "Unsupported ZSNES 2 architecture: $(DEB_HOST_ARCH)" >&2; \
			echo "Supported architectures: $(SUPPORTED_ARCHES)" >&2; \
			exit 1; \
			;; \
	esac

override_dh_auto_build:
	dh_auto_build -- \
		ARCH=LINUX \
		BITS=$(UPSTREAM_BITS) \
		CPU=$(UPSTREAM_CPU) \
		BINARY=zsnes2 \
		EXTRA_CFLAGS='-DZCONF=\"zsnes2\"' \
		WITH_PIPEWIRE= \
		WITH_AO=

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	dh_auto_test -- \
		ARCH=LINUX \
		BITS=$(UPSTREAM_BITS) \
		CPU=$(UPSTREAM_CPU) \
		BINARY=zsnes2 \
		EXTRA_CFLAGS='-DZCONF=\"zsnes2\"' \
		WITH_PIPEWIRE= \
		WITH_AO=
endif

override_dh_auto_install:
	install -Dm755 zsnes2 "$(CURDIR)/debian/zsnes2/usr/bin/zsnes2"
	set -e; \
	for ICON_SIZE in 16x16 32x32 48x48 64x64 128x128; do \
		install -Dm644 "img/$${ICON_SIZE}x32.png" \
			"$(CURDIR)/debian/zsnes2/usr/share/icons/hicolor/$$ICON_SIZE/apps/io.github.xyproto.zsnes2.png"; \
	done
	install -d "$(CURDIR)/debian/zsnes2/usr/share/applications"
	sed \
		-e 's/^Name=ZSNES$$/Name=ZSNES 2/' \
		-e 's/^Exec=zsnes /Exec=zsnes2 /' \
		-e 's/^TryExec=zsnes$$/TryExec=zsnes2/' \
		-e 's/^Icon=io\.github\.xyproto\.zsnes$$/Icon=io.github.xyproto.zsnes2/' \
		-e 's/^StartupWMClass=zsnes$$/StartupWMClass=zsnes2/' \
		linux/zsnes.desktop \
		> "$(CURDIR)/debian/zsnes2/usr/share/applications/io.github.xyproto.zsnes2.desktop"
	install -d "$(CURDIR)/debian/zsnes2/usr/share/metainfo"
	sed \
		-e 's/io\.github\.xyproto\.zsnes/io.github.xyproto.zsnes2/g' \
		-e 's#<name>ZSNES</name>#<name>ZSNES 2</name>#' \
		-e 's#<binary>zsnes</binary>#<binary>zsnes2</binary>#' \
		linux/io.github.xyproto.zsnes.metainfo.xml \
		> "$(CURDIR)/debian/zsnes2/usr/share/metainfo/io.github.xyproto.zsnes2.metainfo.xml"
	install -d "$(CURDIR)/debian/zsnes2/usr/share/man/man1"
	sed \
		-e 's/^ZSNES -/zsnes2 -/' \
		-e 's/^\.B ZSNES$$/.B zsnes2/' \
		-e 's/^ZSNES$$/zsnes2/' \
		-e 's#~/.zsnes#~/.config/zsnes2#g' \
		man/zsnes.1 \
		> "$(CURDIR)/debian/zsnes2/usr/share/man/man1/zsnes2.1"
	chmod 0644 "$(CURDIR)/debian/zsnes2/usr/share/applications/io.github.xyproto.zsnes2.desktop"
	chmod 0644 "$(CURDIR)/debian/zsnes2/usr/share/metainfo/io.github.xyproto.zsnes2.metainfo.xml"
	chmod 0644 "$(CURDIR)/debian/zsnes2/usr/share/man/man1/zsnes2.1"

override_dh_auto_clean:
	dh_auto_clean -- BINARY=zsnes2
	$(MAKE) -C test clean
